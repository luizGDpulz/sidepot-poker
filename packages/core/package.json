{
  "name": "@sidepot/core",
  "version": "0.1.0",
  "description": "Deterministic zero-dependency Texas Hold'em & Omaha poker domain engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
